# =============================================================================
# HappyPaws API — Environment Variables Reference
# =============================================================================
# Copy this file and fill in the values for your environment.
# ASP.NET Core reads environment variables by replacing ":" with "__".
# Example: Jwt:Key becomes Jwt__Key as an environment variable.
#
# DEVELOPMENT: Use `dotnet user-secrets` instead of environment variables.
#              See README.md → "Secret management" for setup commands.
# PRODUCTION:  Set these as environment variables in your deployment platform
#              (Elastic Beanstalk, Docker, etc.).
#
# Keys marked [REQUIRED] will cause startup failures or silent breakage if absent.
# Keys marked [DEV-SKIPPED] are not needed locally — local stubs are used instead.
# =============================================================================

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Production

# --- Database [REQUIRED] ---
# PostgreSQL + PostGIS connection string.
ConnectionStrings__DefaultConnection=Host=<host>;Port=5432;Database=happypaws;Username=<user>;Password=<password>

# --- JWT [REQUIRED] ---
# Signing key must be at least 32 bytes (256 bits).
# Generate: openssl rand -base64 32
Jwt__Key=<32-char-minimum-random-secret>
Jwt__Issuer=https://happypaws.lk
Jwt__Audience=https://happypaws.lk
Jwt__ExpiryMinutes=15

# --- Google Gemini AI [REQUIRED for rescue photo triage] ---
# Get your key at: https://aistudio.google.com/app/apikey
# If absent, urgency classification falls back to a rule-based classifier.
Gemini__ApiKey=AIza...
Gemini__Model=gemini-2.0-flash
Gemini__TimeoutSeconds=10

# --- Firebase FCM [DEV-SKIPPED] ---
# Required in production for push notifications.
# Steps to obtain:
#   1. Firebase Console → Project Settings → Service accounts
#   2. Click "Generate new private key" → download the JSON file
#   3. Base64-encode it: openssl base64 -in service-account.json | tr -d '\n'
Firebase__ServiceAccountJson=<base64-encoded-service-account-json>

# --- Cloudflare R2 [DEV-SKIPPED] ---
# Required in production for photo and KYC document storage.
# AccountId: Cloudflare Dashboard → right sidebar
# Access key: R2 → Manage R2 API tokens → Create API token (Object Read & Write)
Storage__Provider=R2
Storage__AccountId=<cloudflare-account-id>
Storage__AccessKey=<r2-access-key-id>
Storage__SecretKey=<r2-secret-access-key>
Storage__PublicBucket=happypaws-public
Storage__PrivateBucket=happypaws-private
Storage__CustomDomain=cdn.happypaws.lk

# --- AWS SES [DEV-SKIPPED] ---
# Required in production for transactional emails (OTP, KYC decisions).
# IAM user needs the AmazonSESFullAccess policy (or scoped ses:SendEmail).
# Verify the sending domain in the SES console before going live.
Ses__Region=ap-south-1
Ses__FromAddress=noreply@happypaws.lk
Ses__AccessKey=<aws-iam-access-key-id>
Ses__SecretKey=<aws-iam-secret-access-key>

# --- CORS ---
# Comma-indexed array of allowed origins. An empty list blocks all browser requests.
Cors__AllowedOrigins__0=https://happypaws.lk
Cors__AllowedOrigins__1=https://admin.happypaws.lk

# --- Feature Flags ---
# Set to true to bypass rate limiting during load testing or Postman automation.
RateLimiting__Disabled=false
