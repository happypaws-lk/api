# Runtime environment
ASPNETCORE_ENVIRONMENT=Production

# Database
# In production, injected from SSM SecureString /happypaws/prod/database_url by the deploy workflow.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/happypaws

# JWT
Jwt__Key=<32-char-minimum-random-secret>
Jwt__Issuer=https://happypaws.lk
Jwt__Audience=https://happypaws.lk
Jwt__ExpiryMinutes=15

# Google Gemini AI
Gemini__ApiKey=AIza...
Gemini__Model=gemini-2.0-flash
Gemini__TimeoutSeconds=10

# Firebase FCM
Firebase__ServiceAccountJson=<base64-encoded-service-account-json>

# Object storage
# Use Cloudflare R2 in production and MinIO locally. The provider is selected by
# configuration — set Storage__ServiceUrl for MinIO, leave it unset for R2.
Storage__ServiceUrl=                          # MinIO only. e.g. http://localhost:9000. Leave blank for R2.
Storage__AccountId=<cloudflare-account-id>    # R2 only. Not required when ServiceUrl is set.
Storage__AccessKey=<access-key-id>            # R2 API token key, or MinIO root user.
Storage__SecretKey=<secret-access-key>        # R2 API token secret, or MinIO root password.
Storage__PublicBucket=happypaws-public
Storage__PrivateBucket=happypaws-private
Storage__CustomDomain=cdn.happypaws.lk        # R2 custom domain for public URLs (production only).
Storage__PublicBaseUrl=                       # Override public URL base. e.g. http://localhost:9000/happypaws-public for MinIO.

# AWS SES
# In production, Ses__AccessKey and Ses__SecretKey are injected from SSM SecureStrings.
# In local dev with Features__UseRealServicesInDev=false, email is mocked (LocalEmailSender).
Ses__Region=ap-southeast-1
Ses__FromAddress=noreply@happypaws.lk
Ses__AccessKey=<ses-iam-access-key-id>
Ses__SecretKey=<ses-iam-secret-access-key>

# CORS
Cors__AllowedOrigins__0=https://happypaws.lk
Cors__AllowedOrigins__1=https://admin.happypaws.lk

# Feature flags
RateLimiting__Disabled=false
Features__EnableApiDocs=true
# Features__UseRealServicesInDev=false
