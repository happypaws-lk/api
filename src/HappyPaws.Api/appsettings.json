{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://happypaws.lk",
    "Audience": "https://happypaws.lk",
    "ExpiryMinutes": 15
  },
  "Gemini": {
    "ApiKey": "",
    "TimeoutSeconds": 10,
    "Model": "gemini-2.0-flash"
  },
  "SystemConfig": {
    "AlertRadiusKm": 10
  },
  "Storage": {
    "Provider": "R2",
    "PublicBucket": "happypaws-public",
    "PrivateBucket": "happypaws-private"
  },
  "Firebase": {
    "ProjectId": "happypaws-lk"
  },
  "Features": {
    "EnableApiDocs": false
  }
}
