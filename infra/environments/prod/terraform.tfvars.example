# Copy this file to terraform.tfvars and fill in real values.
# Never commit terraform.tfvars — it contains secrets and is listed in .gitignore.

# Database
db_master_username = "happypaws"
db_master_password = "<strong-random-password>"
# db_bundle_id       = "micro_2_0" # optional: micro_2_0 | small_2_0 | medium_2_0 | large_2_0

# Container service
# power options: nano | micro | small | medium | large | xlarge
container_service_power = "small"
# Set to 3 for high-availability mode (three nodes with load balancing)
container_service_scale = 1

# GitHub OIDC — must match your repository slug exactly
github_repo = "happypaws-lk/api"

# Application secrets
jwt_key                       = "<32-char-minimum-random-secret>"
gemini_api_key                = "AIza..."
firebase_service_account_json = "<base64-encoded-service-account-json>"

# Cloudflare R2 storage
storage_account_id = "<cloudflare-account-id>"
storage_access_key = "<r2-access-key-id>"
storage_secret_key = "<r2-secret-access-key>"
